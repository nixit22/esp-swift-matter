+++ b/components/esp_matter/data_model_provider/clusters/closure_control/integration.cpp
@@ -40,6 +40,7 @@

 std::unordered_map<EndpointId, LazyRegisteredServerCluster<ClosureControlCluster>> gServers;
 std::unordered_map<EndpointId, ClosureControlClusterDelegate *> gDelegates;
+std::unordered_map<EndpointId, DataModel::Nullable<GenericOverallCurrentState>> gInitialStates;

 } // namespace

@@ -56,6 +57,19 @@
     gDelegates[endpointId] = &delegate;
 }

+void MatterClosureControlSetInitialOverallCurrentState(EndpointId endpointId,
+                                                        const DataModel::Nullable<GenericOverallCurrentState> &state)
+{
+    gInitialStates[endpointId] = state;
+}
+
+ClosureControlCluster *GetClusterInstance(EndpointId endpointId)
+{
+    auto it = gServers.find(endpointId);
+    VerifyOrReturnValue(it != gServers.end() && it->second.IsConstructed(), nullptr);
+    return &it->second.Cluster();
+}
+
 } // namespace ClosureControl
 } // namespace Clusters
 } // namespace app
